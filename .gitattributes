# 줄바꿈 정규화. 저장소에는 LF 로 저장하고 체크아웃 시 OS 에 맞춘다.
* text=auto eol=lf

# 셸 스크립트는 반드시 LF (CRLF 면 실행이 깨진다)
*.sh text eol=lf
gradlew text eol=lf

# Windows 배치·PowerShell 은 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 바이너리 — diff·정규화 대상 아님
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# 운영 서버의 /opt/rizen/.env 로 복사해 채운다.  chmod 600 .env
# ★ 이 파일(.env.example)만 커밋한다. 값을 채운 .env 는 절대 커밋하지 않는다.

# ── 이미지 태그 ──
API_TAG=latest

# ── DB (Supabase, 세션 풀러 5432 — 트랜잭션 풀러 6543 은 쓰지 않는다) ──
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<프로젝트ref>
DB_PASSWORD=
DB_POOL_SIZE=5

# ── 인증·암호화 (openssl rand -base64 48 / openssl rand -base64 32) ──
JWT_SECRET=
PHONE_ENC_KEY=

# 관리자 계정이 하나도 없을 때만 첫 계정을 만든다. 첫 기동·로그인 확인 후 두 줄을 지우고 재시작한다.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ── 프론트 도메인 ──
CORS_ALLOWED_ORIGINS=https://www.도메인

# ── 접속자 IP (Cloudflare Tunnel 뒤) ──
CLIENT_IP_HEADER=CF-Connecting-IP

# ── 이미지 저장소 (Cloudflare R2) ──
STORAGE_TYPE=s3
S3_BUCKET=rizenfood-images
S3_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com
S3_REGION=auto
CDN_BASE_URL=https://img.도메인
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── 결제 (포트원) — 콘솔 설정은 deploy/PORTONE.md ──
PAYMENT_PROVIDER=portone
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_STORE_ID=
# 결제수단별 채널 키. 비워 둔 결제수단은 결제 화면에 나오지 않는다.
PORTONE_CHANNEL_KEY=
PORTONE_CHANNEL_KEY_TRANSFER=
PORTONE_CHANNEL_KEY_KAKAOPAY=
PORTONE_CHANNEL_KEY_NAVERPAY=
PORTONE_CHANNEL_KEY_TOSSPAY=

# ── Cloudflare Tunnel ──
CLOUDFLARE_TUNNEL_TOKEN=

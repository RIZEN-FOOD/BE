# 운영 서버의 /opt/rizen/.env 로 복사해 채운다.  chmod 600 .env
# ★ 이 파일(.env.example)만 커밋한다. 값을 채운 .env 는 절대 커밋하지 않는다.

# ── 도메인·HTTPS ──
# www 없이. Caddy 가 www.도메인 인증서를 자동 발급하고, 맨도메인은 www 로 넘긴다.
DOMAIN=rizenfood.co.kr
# 인증서 만료 안내를 받을 메일
ACME_EMAIL=

# ── 이미지 태그 ──
API_TAG=latest
WEB_TAG=latest

# ── DB (이 서버 안의 PostgreSQL — docker-compose 의 db) ──
# 접속 주소(DB_URL)는 docker-compose.prod.yml 이 넣는다.
DB_USERNAME=rizen
# openssl rand -base64 24  — 길고 무작위로
DB_PASSWORD=
DB_POOL_SIZE=5

# ── 인증·암호화 (openssl rand -base64 48 / openssl rand -base64 32) ──
JWT_SECRET=
PHONE_ENC_KEY=

# 관리자 계정이 하나도 없을 때만 첫 계정을 만든다. 첫 기동·로그인 확인 후 두 줄을 지우고 재시작한다.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ── 프론트 주소 ──
CORS_ALLOWED_ORIGINS=https://www.rizenfood.co.kr

# ── 접속자 IP ──
# Caddy 가 실제 연결 주소로 덮어쓰는 헤더. 이 값 말고 다른 헤더(X-Forwarded-For 등)를 넣지 않는다.
CLIENT_IP_HEADER=X-Real-IP

# ── 업로드 사진 (서버 디스크, Caddy 가 /uploads 로 서빙) ──
STORAGE_TYPE=local
STORAGE_LOCAL_URL=/uploads

# ── 백업 (backup.sh → Lightsail 저장소 버킷) ──
# 백업은 암호화해서 올린다. 이 암호를 잃으면 백업을 열 수 없다 — 서버 밖(비밀번호 관리 앱)에도 보관.
BACKUP_PASSPHRASE=
BACKUP_BUCKET=
BACKUP_REGION=ap-northeast-2
# Lightsail 버킷 → Permissions → Access keys 에서 만든 키
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=

# ── 결제 (포트원) — 콘솔 설정은 deploy/PORTONE.md ──
PAYMENT_PROVIDER=portone
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_STORE_ID=
# 결제수단별 채널 키. 비워 둔 결제수단은 결제 화면에 나오지 않는다.
PORTONE_CHANNEL_KEY=
PORTONE_CHANNEL_KEY_TRANSFER=
PORTONE_CHANNEL_KEY_KAKAOPAY=
PORTONE_CHANNEL_KEY_NAVERPAY=
PORTONE_CHANNEL_KEY_TOSSPAY=

# ── 간편 로그인 (카카오·네이버) — 절차는 BE/deploy/SOCIAL_LOGIN.md ──
# 손님이 보는 사이트 주소(끝에 / 없이). www 를 포함한 실제 주소.
OAUTH_REDIRECT_BASE=https://www.rizenfood.co.kr
# 비워 두면 그 제공자 버튼이 안 보인다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
